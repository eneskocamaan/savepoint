{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Savepoint",
  "version": "0.1.0",
  "identifier": "dev.savepoint.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Savepoint",
        "width": 380,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#131416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "eneskocamaan",
    "copyright": "Copyright (c) 2026 eneskocamaan. MIT License.",
    "shortDescription": "Savepoint window",
    "icon": ["icons/icon.ico"]
  }
}
